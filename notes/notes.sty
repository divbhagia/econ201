% ECON 201 lecture notes style, shared by notes/notesNN.tex. Loaded after
% \documentclass; every notes file still starts with the \DocumentMetadata
% line that turns tagging on, and compiles with LuaLaTeX.
%
% Provides:
%   \notestitle{Lecture N}{Title}{Lead-in sentence}   the page-one header
%   \key{term}                                         a key term, bold accent
%   \begin{keypanel}[Title] ... \end{keypanel}         a cream panel
%   \begin{takeaways} \item ... \end{takeaways}        closing summary panel
% Colours follow CLAUDE.md: #8f4100 for text on the cream panel (the brand
% orange falls below 4.5:1 there), #BF5700 for rules and headings on white.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notes}[2026/10/05 ECON 201 lecture notes]

\RequirePackage[letterpaper, margin=0.9in, top=0.75in, bottom=0.9in]{geometry}
\RequirePackage{fontspec}
\setmainfont{Fira Sans}
\RequirePackage{amsmath}
\RequirePackage{microtype}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{xcolor}
\definecolor{accent}{HTML}{BF5700}
\definecolor{accentdark}{HTML}{8F4100}
\definecolor{ink}{HTML}{1A1A1A}
\definecolor{muted}{HTML}{595A5B}
\definecolor{cream}{HTML}{FDF3EA}
\definecolor{rulegrey}{HTML}{D9D9D9}
\RequirePackage[most]{tcolorbox}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true, urlcolor=accent, linkcolor=ink}

% Body: a little more leading and air between paragraphs than article's.
\linespread{1.05}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}
\AtBeginDocument{\color{ink}}

% Numbered sections in the accent, with a thin grey rule beneath.
\titleformat{\section}{\large\bfseries\color{accent}}{\thesection.}{0.5em}{}%
  [{\color{rulegrey}\titlerule[0.6pt]}]
\titlespacing*{\section}{0pt}{12pt plus 2pt}{5pt}

% Key terms and ideas: bold in the accent colour, like the section headings.
\newcommand{\key}[1]{\textcolor{accent}{\textbf{#1}}}

% Footer: course and lecture on the left, page x of y on the right.
\newcommand{\notes@lecture}{}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\small\color{muted}ECON 201 \textperiodcentered\ \notes@lecture\ notes}
\fancyfoot[R]{\small\color{muted}Page \thepage\ of \pageref{LastPage}}

% Page-one header: title line, accent rule, lead-in in grey.
\newcommand{\notestitle}[3]{%
  \gdef\notes@lecture{#1}%
  \thispagestyle{fancy}%
  {\LARGE\bfseries\color{accent}#1: #2}\hfill{\large\color{muted}ECON 201}\par
  \vspace{4pt}{\color{accent}\hrule height 1.2pt}\par
  \vspace{6pt}{\color{muted}#3}\par
  \vspace{4pt}}

% Cream panel for a definition, rule, or table. Text inside uses the
% darker accent so it keeps 4.5:1 on the tinted background.
\newtcolorbox{keypanel}[1][]{
  enhanced, colback=cream, colframe=accent, boxrule=0.6pt, arc=2pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=8pt, after skip=10pt,
  title={#1}, fonttitle=\bfseries, coltitle=white,
  attach boxed title to top left={yshift=-2mm, xshift=4mm},
  boxed title style={colback=accent, colframe=accent, arc=2pt, boxrule=0pt,
    left=5pt, right=5pt, top=2pt, bottom=2pt},
  colupper=ink}

% Closing summary: a titled cream panel holding an itemized list.
\newenvironment{takeaways}
  {\begin{keypanel}[What to take away]\begin{itemize}
     \setlength{\itemsep}{3pt}\setlength{\parskip}{0pt}}
  {\end{itemize}\end{keypanel}}
